{
  "name": "nexengine-ops-agent",
  "version": "1.1.0",
  "description": "Runtime operacional NexEngine — agent VPS + workers de fila + scheduler + healthcheck (Playwright/PM2).",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "engines": { "node": ">=18.17.0" },
  "scripts": {
    "start": "node src/index.js",
    "start:worker": "node src/worker.js",
    "start:scheduler": "node src/scheduler.js",
    "start:healthcheck": "node src/healthcheck.js",
    "dev": "node --watch src/index.js",
    "dev:worker": "node --watch src/worker.js",
    "dev:scheduler": "node --watch src/scheduler.js",
    "setup": "bash scripts/startup.sh",
    "deploy": "bash scripts/deploy.sh",
    "healthcheck": "bash scripts/healthcheck.sh",
    "spotify:session": "bash scripts/spotify-session.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:logs:agent": "pm2 logs nexengine-ops-agent",
    "pm2:logs:workers": "pm2 logs /nexengine-worker-/",
    "pm2:logs:scheduler": "pm2 logs nexengine-scheduler",
    "pm2:save": "pm2 save",
    "docker:build": "docker compose -f docker-compose.worker.yml build",
    "docker:up": "docker compose -f docker-compose.worker.yml up -d",
    "docker:down": "docker compose -f docker-compose.worker.yml down",
    "docker:logs": "docker compose -f docker-compose.worker.yml logs -f"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "playwright": "^1.47.2",
    "systeminformation": "^5.23.5"
  }
}
