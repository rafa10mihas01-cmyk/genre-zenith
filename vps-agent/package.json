{
  "name": "nexengine-ops-agent",
  "version": "1.0.0",
  "description": "Agente VPS oficial do NexEngine — executa PM2/Docker/shell controlado, coleta métricas, healthcheck, watchdog e reporta para o painel /sistema (Lovable Cloud).",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "engines": { "node": ">=18.17.0" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs nexengine-ops-agent",
    "pm2:restart": "pm2 restart nexengine-ops-agent",
    "pm2:save": "pm2 save"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "systeminformation": "^5.23.5"
  }
}
