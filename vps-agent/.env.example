# ==== OBRIGATÓRIOS ====
# Token compartilhado com o Lovable Cloud (mesmo valor configurado em OPS_AGENT_TOKEN no painel)
OPS_AGENT_TOKEN=cole_aqui_o_mesmo_valor_do_painel

# Base das edge functions (NÃO mude se o projeto for o oficial)
OPS_BASE=https://xtxxjmkijeyxkdyxtvsf.functions.supabase.co

# Identidade desta VPS (precisa ser único por máquina/agente)
AGENT_ID=vps-prod-01
BOT_NAME=vps-agent

# ==== INTERVALOS (ms) ====
POLL_INTERVAL_MS=3000
METRICS_INTERVAL_MS=30000
HEALTHCHECK_INTERVAL_MS=60000

# ==== WATCHDOG / SPOTIFY BOT ====
# Nome do processo PM2 do bot que coleta no Spotify for Artists
SPOTIFY_BOT_PM2_NAME=spotify-bot
# Restart automático se o bot ficar sem heartbeat por mais que isso (segundos)
SPOTIFY_BOT_STALE_AFTER_S=600
# Máximo de restarts automáticos por hora antes de abrir incidente e pausar watchdog
WATCHDOG_MAX_RESTARTS_PER_HOUR=4

# ==== DOCKER ====
DOCKER_ENABLED=true

# ==== SHELL WHITELIST ====
# Lista separada por vírgula de comandos permitidos via shell_exec (regex match no início)
SHELL_WHITELIST=^pm2 ,^docker ps,^docker logs ,^df -h,^free -h,^uptime$,^uname -a$,^systemctl status ,^journalctl -u ,^ls /var/log
SHELL_TIMEOUT_MS=15000

# ==== WORKERS (queue/worker) ====
# Quantos processos worker o ecosystem.config.cjs deve subir
WORKER_COUNT=2
# Identificação lógica do worker (aparece no painel /sistema → Workers)
WORKER_KIND=spotify-artists-worker
# Tipos de job que este worker aceita (vazio = todos os registrados em handlers/)
WORKER_JOB_TYPES=spotify.artist.fetch,spotify.deal.collect
# Tempo (s) que o job fica reservado antes de ser requeue por jobs-maintenance
WORKER_LEASE_SECONDS=300
# Pausa entre polls quando a fila está vazia (ms)
WORKER_IDLE_SLEEP_MS=2000
# Frequência de heartbeat (ms)
WORKER_HEARTBEAT_MS=15000
