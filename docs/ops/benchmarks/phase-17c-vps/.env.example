# BENCH 17-C — variáveis de ambiente (preencher na VPS)
# Copiar para .env e exportar antes de rodar o script.

# --- Gateway Client Credentials (CC) ---
BENCH_CC_TOKEN_URL=https://accounts.spotify.com/api/token
BENCH_CC_CLIENT_ID=
BENCH_CC_CLIENT_SECRET=

# --- OAuth de usuário (token já obtido, com escopos de leitura + escrita de playlist) ---
BENCH_OAUTH_ACCESS_TOKEN=

# --- VPS proxy ---
# Base da VPS que expõe a Spotify Web API (deve aceitar paths /v1/...)
BENCH_VPS_BASE_URL=
# Header de autenticação opcional (ex: "Bearer xxx" ou "X-Api-Key xxx" via header custom)
BENCH_VPS_AUTH_HEADER=

# --- Sandboxes para T3 (escrita) — IDs de playlists DEDICADAS, não de produção ---
BENCH_SANDBOX_OAUTH_PLAYLIST_ID=
BENCH_SANDBOX_VPS_PLAYLIST_ID=

# --- Parâmetros do protocolo ---
BENCH_T1_DELAY_SEC=900
BENCH_LOAD_DURATION_SEC=60
